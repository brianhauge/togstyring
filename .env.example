# Example configuration - read by docker-compose.yml
# Copy this file to .env and adjust values as needed

# MQTT Configuration
MQTT_BROKER_URL=tcp://mqtt-broker:1883
MQTT_CLIENT_ID=mqtt-bridge-client
MQTT_TOPIC=homeassistant/togstyring/ir_sensor
MQTT_USERNAME=
MQTT_PASSWORD=

# API Configuration
API_BASE_URL=http://api:8080

# PostgreSQL Configuration (the API connects with these too;
# set DATABASE_URL / DATABASE_USERNAME / DATABASE_PASSWORD only to point it elsewhere)
POSTGRES_DB=datetime_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
